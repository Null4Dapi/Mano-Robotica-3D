MOTOR ManoBionica_Error;
INICIO
    // El dedo índice solo puede rotar de 0° a 90°
    DEDO INDICE FALANGE PROXIMAL ROTAR 135;
    
    // Articulación no existente
    DEDO PIE FALANGE PROXIMAL ROTAR 45;
    
    // Hiperextensión negativa prohibida
    DEDO PULGAR FALANGE PROXIMAL ROTAR -30;
FIN

