inicio
    // =========================================================================
    // SECUENCIA CINEMÁTICA BIOMECÁNICA COORDINADA (18 GDL)
    // =========================================================================

    // FASE 1: CIERRE COORDINADO EN PUÑO / AGARRE CILÍNDRICO
    // 1.1 Flexión de falanges proximales (MCP) de los cuatro dedos
    rotar indice falange_1 45 grados;
    rotar medio falange_1 45 grados;
    rotar anular falange_1 45 grados;
    rotar menique falange_1 45 grados;

    // 1.2 Flexión de falanges mediales (PIP)
    rotar indice falange_2 60 grados;
    rotar medio falange_2 60 grados;
    rotar anular falange_2 60 grados;
    rotar menique falange_2 60 grados;

    // 1.3 Cierre de puntas distales (DIP)
    rotar indice falange_3 35 grados;
    rotar medio falange_3 35 grados;
    rotar anular falange_3 35 grados;
    rotar menique falange_3 35 grados;

    // 1.4 Oposición y envoltura del pulgar sobre el puño
    rotar pulgar falange_1 45 grados;
    rotar pulgar falange_2 40 grados;
    rotar pulgar falange_3 35 grados;

    // Pausa cinemática con agarre cerrado
    esperar 300 ms;

    // FASE 2: EXTENSIÓN Y APERTURA COMPLETA
    // Liberar pulgar
    rotar pulgar falange_1 0 grados;
    rotar pulgar falange_2 0 grados;
    rotar pulgar falange_3 0 grados;

    // Apertura armónica de los cuatro dedos
    rotar indice falange_1 0 grados;
    rotar medio falange_1 0 grados;
    rotar anular falange_1 0 grados;
    rotar menique falange_1 0 grados;

    rotar indice falange_2 0 grados;
    rotar medio falange_2 0 grados;
    rotar anular falange_2 0 grados;
    rotar menique falange_2 0 grados;

    rotar indice falange_3 0 grados;
    rotar medio falange_3 0 grados;
    rotar anular falange_3 0 grados;
    rotar menique falange_3 0 grados;

    esperar 250 ms;

    // FASE 3: PINZA DE PRECISIÓN (OPOSICIÓN PULGAR - ÍNDICE)
    rotar indice falange_1 45 grados;
    rotar indice falange_2 50 grados;
    rotar indice falange_3 30 grados;

    rotar pulgar falange_1 48 grados;
    rotar pulgar falange_2 42 grados;
    rotar pulgar falange_3 35 grados;

    esperar 300 ms;

    // FASE 4: RETORNO SUAVE A REPOSO NEUTRAL
    rotar indice falange_1 0 grados;
    rotar indice falange_2 0 grados;
    rotar indice falange_3 0 grados;

    rotar pulgar falange_1 0 grados;
    rotar pulgar falange_2 0 grados;
    rotar pulgar falange_3 0 grados;
fin
